{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Quota Widget",
  "version": "0.1.0",
  "identifier": "local.codex.quota-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex 额度卡片",
        "width": 390,
        "height": 292,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "state": "active",
          "radius": 24
        },
        "minWidth": 330,
        "minHeight": 260
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
